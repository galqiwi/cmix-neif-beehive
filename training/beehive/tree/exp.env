# training-form environment of package D (tf/3_train/chain/08_w2048.env), data path from $PKG
export TFT_GEOMETRY=poc8m_w2048
export PK_DUMP_DIR=${PKG:?set PKG to the package-D directory (training/README.md stage c)}
export TFT_DATA_DIR=$PKG
export TFT_MMAP=1
export ZCTX_ARM=pkd
export ZCTX_SEED=20260901
export PK_LAST_X0ROW=1
export PK_REDIRMERGE=1
export PK_SLOT_DIM=16
export TFT_OPTIMIZER_BATCH_TOKENS=1048576
export TFT_MICRO_BATCH_TOKENS=${TFT_MICRO_BATCH_TOKENS:-262144}
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
